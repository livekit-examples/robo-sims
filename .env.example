# LiveKit credentials of the simulations. Copy to .env.local (git-ignored).
# Use the same project and room as the controller app, so it sees the simulation.
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=<api key>
LIVEKIT_API_SECRET=<api secret>
LIVEKIT_ROOM_NAME=<the controller app's room>

# Shared simulations use a separate room from direct robot sessions.
SIM_LIVEKIT_ROOM_NAME=teleop-simulations-dev
SIM_CONTROL_TURN_SECONDS=60
SIM_IDLE_TIMEOUT_SECONDS=120
SIM_MAX_RUNTIME_SECONDS=21600
