{
  "schema_version": 1,
  "label": "trossen-workbench-whack",
  "exclude_data_tracks": [],
  "exclude_video_tracks": [],
  "exclude_audio_tracks": [],
  "default_video_rate_hz": 12,
  "control": {
    "scope": "robot",
    "ownership": "portal_active_operator"
  },
  "audio_tracks": {},
  "control_interfaces": {
    "left_arm": {
      "label": "Left arm",
      "kind": "arm",
      "frame_id": "left_arm_base_link",
      "joint_names": [
        "left_arm_joint_1",
        "left_arm_joint_2",
        "left_arm_joint_3",
        "left_arm_joint_4",
        "left_arm_joint_5",
        "left_arm_joint_6"
      ],
      "operations": {
        "joint_position": {
          "profile": "joints.trajectory.v1",
          "command": {
            "track_name": "/left_arm/joint_trajectory",
            "msg_type": "trajectory_msgs/msg/JointTrajectory",
            "format": "json"
          },
          "feedback_tracks": [
            "/left_arm/joint_states"
          ],
          "required_feedback_tracks": [
            "/left_arm/joint_states"
          ],
          "presentations": [
            "joint_sliders"
          ]
        },
        "gripper_position": {
          "profile": "gripper.position.v1",
          "control_channel": "gripper",
          "joint_names": [
            "left_gripper_joint"
          ],
          "command": {
            "track_name": "/left_gripper/joint_trajectory",
            "msg_type": "trajectory_msgs/msg/JointTrajectory",
            "format": "json"
          },
          "feedback_tracks": [
            "/left_arm/joint_states"
          ],
          "required_feedback_tracks": [
            "/left_arm/joint_states"
          ],
          "presentations": [
            "gripper_controls"
          ]
        }
      }
    },
    "right_arm": {
      "label": "Right arm",
      "kind": "arm",
      "frame_id": "right_arm_base_link",
      "joint_names": [
        "right_arm_joint_1",
        "right_arm_joint_2",
        "right_arm_joint_3",
        "right_arm_joint_4",
        "right_arm_joint_5",
        "right_arm_joint_6"
      ],
      "operations": {
        "joint_position": {
          "profile": "joints.trajectory.v1",
          "command": {
            "track_name": "/right_arm/joint_trajectory",
            "msg_type": "trajectory_msgs/msg/JointTrajectory",
            "format": "json"
          },
          "feedback_tracks": [
            "/right_arm/joint_states"
          ],
          "required_feedback_tracks": [
            "/right_arm/joint_states"
          ],
          "presentations": [
            "joint_sliders"
          ]
        },
        "gripper_position": {
          "profile": "gripper.position.v1",
          "control_channel": "gripper",
          "joint_names": [
            "right_gripper_joint"
          ],
          "command": {
            "track_name": "/right_gripper/joint_trajectory",
            "msg_type": "trajectory_msgs/msg/JointTrajectory",
            "format": "json"
          },
          "feedback_tracks": [
            "/right_arm/joint_states"
          ],
          "required_feedback_tracks": [
            "/right_arm/joint_states"
          ],
          "presentations": [
            "gripper_controls"
          ]
        }
      }
